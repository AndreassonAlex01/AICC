{
  "expo": {
    "name": "AICC",
    "slug": "aicc",
    "scheme": "aicc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alexanderandreasson.aicc",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "AICC uses your photo library so you can pick a meal photo to analyze.",
          "cameraPermission": "AICC uses your camera to photograph a meal for AI analysis."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F6F3EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#11141C"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
